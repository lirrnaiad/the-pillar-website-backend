# GraphQL Schema for The Pillar E-Publication Website
# This file defines all queries, mutations, and types for the publication platform

# ==================== ENUMS ====================

"""
Article workflow status enumeration.
Flow: DRAFT → PENDING_REVIEW → PUBLISHED → ARCHIVED
                  ↓
              REJECTED (with feedback)
"""
enum ArticleStatus {
    DRAFT
    PENDING_REVIEW
    PUBLISHED
    ARCHIVED
    REJECTED
}

"""
Media file type enumeration.
"""
enum MediaType {
    IMAGE
    VIDEO
    DOCUMENT
}

"""
Audit action type enumeration for tracking entity changes.
"""
enum AuditAction {
    CREATE
    UPDATE
    DELETE
    PUBLISH
    ARCHIVE
    RESTORE
    LOGIN
    LOGOUT
}

# ==================== TYPES ====================

"""
Represents a system user (admin, editor, writer).
"""
type User {
    id: ID!
    email: String!
    firstName: String!
    lastName: String!
    fullName: String!
    avatarUrl: String
    bio: String
    role: Role
    createdAt: DateTime!
    updatedAt: DateTime!
}

"""
Represents a user role with associated permissions.
"""
type Role {
    id: ID!
    name: String!
    permissions: JSON
}

"""
Represents a media file stored in Cloudinary.
"""
type Media {
    id: ID!
    url: String!
    publicId: String
    altText: String
    type: MediaType!
    sizeBytes: Long
    width: Int
    height: Int
    uploadedBy: User
    createdAt: DateTime!
}

"""
Represents an article tag for flexible categorization.
"""
type Tag {
    id: ID!
    name: String!
    slug: String!
}

"""
Represents an article category (News, Feature, Opinion, etc.).
"""
type Category {
    id: ID!
    name: String!
    slug: String!
    description: String
    color: String
}

"""
Represents a publication issue/volume for grouping articles.
"""
type PublicationIssue {
    id: ID!
    title: String!
    slug: String!
    coverUrl: String
    description: String
    publishedAt: DateTime
    createdAt: DateTime!
    articles: [Article!]!
}

"""
Represents an article/post in the publication.
Supports SEO metadata, full-text search, and soft deletes.
"""
type Article {
    id: ID!
    title: String!
    slug: String!
    content: String!
    excerpt: String
    status: ArticleStatus!
    featured: Boolean!
    viewCount: Long!
    author: User!
    category: Category
    cover: Media
    issue: PublicationIssue
    tags: [Tag!]!
    metaTitle: String
    metaDescription: String
    ogImage: String
    createdAt: DateTime!
    updatedAt: DateTime!
    publishedAt: DateTime
}

"""
Represents article revision history for tracking changes.
"""
type ArticleRevision {
    id: ID!
    article: Article!
    title: String!
    content: String!
    changedBy: User!
    changeReason: String
    createdAt: DateTime!
}

"""
Represents an audit log entry for tracking entity changes.
"""
type AuditLog {
    id: ID!
    action: AuditAction!
    entityType: String!
    entityId: ID!
    changedBy: User!
    details: JSON
    createdAt: DateTime!
}

"""
Paginated articles result.
"""
type ArticlesConnection {
    edges: [ArticleEdge!]!
    pageInfo: PageInfo!
    totalCount: Int!
}

"""
Article edge for pagination.
"""
type ArticleEdge {
    node: Article!
    cursor: String!
}

"""
Pagination information.
"""
type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
    startCursor: String
    endCursor: String
}

# ==================== INPUT TYPES ====================

"""
Input for creating an article.
"""
input CreateArticleInput {
    title: String!
    slug: String!
    content: String!
    excerpt: String
    categoryId: ID
    coverId: ID
    issueId: ID
    tagIds: [ID!]
    metaTitle: String
    metaDescription: String
    ogImage: String
    status: ArticleStatus!
}

"""
Input for updating an article.
"""
input UpdateArticleInput {
    id: ID!
    title: String
    slug: String
    content: String
    excerpt: String
    status: ArticleStatus
    featured: Boolean
    categoryId: ID
    coverId: ID
    issueId: ID
    tagIds: [ID!]
    metaTitle: String
    metaDescription: String
    ogImage: String
}

"""
Input for creating a user.

Note: Password is transmitted in plain text and must be sent over HTTPS.
It will be securely hashed before storage.
"""
input CreateUserInput {
    email: String!
    password: String!
    firstName: String!
    lastName: String!
    avatarUrl: String
    bio: String
    roleId: ID
}

"""
Input for updating a user.
"""
input UpdateUserInput {
    id: ID!
    email: String
    firstName: String
    lastName: String
    avatarUrl: String
    bio: String
    roleId: ID
}

"""
Input for creating a media file.
"""
input CreateMediaInput {
    url: String!
    publicId: String
    altText: String
    type: MediaType!
    sizeBytes: Long
    width: Int
    height: Int
}

"""
Input for creating a category.
"""
input CreateCategoryInput {
    name: String!
    slug: String!
    description: String
    color: String
}

"""
Input for updating a category.
"""
input UpdateCategoryInput {
    id: ID!
    name: String
    slug: String
    description: String
    color: String
}

"""
Input for creating a tag.
"""
input CreateTagInput {
    name: String!
    slug: String!
}

"""
Input for updating a tag.
"""
input UpdateTagInput {
    id: ID!
    name: String
    slug: String
}

"""
Input for creating a publication issue.
"""
input CreatePublicationIssueInput {
    title: String!
    slug: String!
    coverUrl: String
    description: String
    publishedAt: DateTime
}

"""
Input for updating a publication issue.
"""
input UpdatePublicationIssueInput {
    id: ID!
    title: String
    slug: String
    coverUrl: String
    description: String
    publishedAt: DateTime
}

"""
Input for article pagination and filtering.
"""
input ArticleFilter {
    status: ArticleStatus
    categoryId: ID
    tagIds: [ID!]
    issueId: ID
    authorId: ID
    featured: Boolean
    search: String
}

"""
Input for article sorting.
"""
input ArticleSort {
    field: ArticleSortField!
    direction: SortDirection!
}

"""
Article sort field enumeration.
"""
enum ArticleSortField {
    TITLE
    CREATED_AT
    UPDATED_AT
    PUBLISHED_AT
    VIEW_COUNT
}

"""
Sort direction enumeration.
"""
enum SortDirection {
    ASC
    DESC
}

# ==================== QUERIES ====================

type Query {
    # Article queries
    """
    Get all articles with optional filtering, sorting, and pagination.
    """
    articles(
        first: Int = 10
        after: String
        filter: ArticleFilter
        sort: ArticleSort
    ): ArticlesConnection!

    """
    Get a single article by ID.
    """
    article(id: ID!): Article

    """
    Get an article by slug (SEO-friendly URL).
    """
    articleBySlug(slug: String!): Article

    """
    Search articles by title, content, or excerpt.
    """
    searchArticles(
        query: String!
        first: Int = 10
        after: String
    ): ArticlesConnection!

    """
    Get featured articles.
    """
    featuredArticles(first: Int = 5): [Article!]!

    """
    Get recent published articles.
    """
    recentArticles(first: Int = 10): [Article!]!

    # User queries
    """
    Get all users.
    """
    users: [User!]!

    """
    Get a single user by ID.
    """
    user(id: ID!): User

    """
    Get current authenticated user.
    """
    me: User

    # Category queries
    """
    Get all categories.
    """
    categories: [Category!]!

    """
    Get a single category by ID.
    """
    category(id: ID!): Category

    """
    Get a category by slug.
    """
    categoryBySlug(slug: String!): Category

    # Tag queries
    """
    Get all tags.
    """
    tags: [Tag!]!

    """
    Get a single tag by ID.
    """
    tag(id: ID!): Tag

    # Media queries
    """
    Get all media files.
    """
    media: [Media!]!

    """
    Get a single media file by ID.
    """
    mediaItem(id: ID!): Media

    # Publication issue queries
    """
    Get all publication issues.
    """
    publicationIssues: [PublicationIssue!]!

    """
    Get a single publication issue by ID.
    """
    publicationIssue(id: ID!): PublicationIssue

    """
    Get a publication issue by slug.
    """
    publicationIssueBySlug(slug: String!): PublicationIssue

    # Audit queries
    """
    Get audit logs.
    """
    auditLogs(
        entityType: String
        entityId: ID
    ): [AuditLog!]!

    # Statistics queries
    """
    Get article statistics.
    """
    articleStats: ArticleStatistics!

    """
    Get publication statistics.
    """
    publicationStats: PublicationStatistics!
}

"""
Article statistics.
"""
type ArticleStatistics {
    totalArticles: Int!
    publishedArticles: Int!
    draftArticles: Int!
    viewsCount: Long!
    avgViewsPerArticle: Float!
}

"""
Publication statistics.
"""
type PublicationStatistics {
    totalIssues: Int!
    totalArticles: Int!
    totalUsers: Int!
    totalMedia: Int!
}

# ==================== MUTATIONS ====================

type Mutation {
    # Article mutations
    """
    Create a new article.
    """
    createArticle(input: CreateArticleInput!): Article!

    """
    Update an existing article.
    """
    updateArticle(input: UpdateArticleInput!): Article!

    """
    Delete an article (soft delete).
    """
    deleteArticle(id: ID!): Boolean!

    """
    Publish an article.
    """
    publishArticle(id: ID!): Article!

    """
    Archive an article.
    """
    archiveArticle(id: ID!): Article!

    """
    Restore a soft-deleted article.
    """
    restoreArticle(id: ID!): Article!

    """
    Increment article view count.
    """
    incrementArticleViews(id: ID!): Article!

    """
    Toggle article featured status.
    """
    toggleFeatured(id: ID!): Article!

    """
    Add tag to article.
    """
    addArticleTag(articleId: ID!, tagId: ID!): Article!

    """
    Remove tag from article.
    """
    removeArticleTag(articleId: ID!, tagId: ID!): Article!

    # User mutations
    """
    Create a new user.
    """
    createUser(input: CreateUserInput!): User!

    """
    Update an existing user.
    """
    updateUser(input: UpdateUserInput!): User!

    """
    Delete a user (soft delete).
    """
    deleteUser(id: ID!): Boolean!

    """
    Change user password.

    Requires: `newPassword` must be at least 8 characters long and include uppercase, lowercase, and numeric characters.
    """
    changePassword(id: ID!, oldPassword: String!, newPassword: String!): Boolean!

    # Category mutations
    """
    Create a new category.
    """
    createCategory(input: CreateCategoryInput!): Category!

    """
    Update an existing category.
    """
    updateCategory(input: UpdateCategoryInput!): Category!

    """
    Delete a category.
    """
    deleteCategory(id: ID!): Boolean!

    # Tag mutations
    """
    Create a new tag.
    """
    createTag(input: CreateTagInput!): Tag!

    """
    Update an existing tag.
    """
    updateTag(input: UpdateTagInput!): Tag!

    """
    Delete a tag.
    """
    deleteTag(id: ID!): Boolean!

    # Media mutations
    """
    Upload a new media file.
    """
    uploadMedia(input: CreateMediaInput!): Media!

    """
    Delete a media file.
    """
    deleteMedia(id: ID!): Boolean!

    # Publication issue mutations
    """
    Create a new publication issue.
    """
    createPublicationIssue(input: CreatePublicationIssueInput!): PublicationIssue!

    """
    Update an existing publication issue.
    """
    updatePublicationIssue(input: UpdatePublicationIssueInput!): PublicationIssue!

    """
    Delete a publication issue.
    """
    deletePublicationIssue(id: ID!): Boolean!
}

# ==================== CUSTOM SCALARS ====================

"""
ISO 8601 DateTime scalar.
"""
scalar DateTime

"""
Long integer scalar for large numbers.
"""
scalar Long

"""
JSON object scalar.
"""
scalar JSON

